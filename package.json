{
  "name": "robomotion-ai",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "description": "RoboMotion AI Stage 7: simulation-only robotics workspace with session-local engineering diagnostics, guided demonstration, privacy-safe exports, and preserved gesture safety controls.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "typecheck:core": "tsc -p tsconfig.core.json",
    "test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test tests/*.test.mjs",
    "verify": "npm run test && npm run typecheck && npm run build",
    "preflight": "node scripts/preflight.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "three": "^0.186.1",
    "@mediapipe/tasks-vision": "1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
